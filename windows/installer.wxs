<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="FuckXter" Language="1033"
           Version="$(var.AppVersion)" Manufacturer="FuckXter"
           UpgradeCode="B9C1D3FA-C06A-4CC2-BEEF-4E502D9E7C3A">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of FuckXter is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Feature Id="ProductFeature" Title="FuckXter" Level="1">
      <ComponentGroupRef Id="AppFiles" />
    </Feature>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="FuckXter" />
      </Directory>
      <Directory Id="CommonProgramsFolder">
        <Directory Id="ApplicationProgramsFolder" Name="FuckXter" />
      </Directory>
    </Directory>
  </Product>
</Wix>
